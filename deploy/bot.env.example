# gohome bot 环境变量（复制为 /etc/gohome/bot.env 并填值；勿提交真实值）
# bot 只绑回环，由 mcp-auth-proxy 转发，本机不直接对公网暴露 MCP。

TOKEN=<telegram_bot_token>
RDB_URL=redis://127.0.0.1:6379

# 启用 MCP：非 0 才启动；也是「免鉴权」时的默认发送目标
MCP_TARGET_CHAT_ID=<你的chat_id>

# 启用 JWT 鉴权（与 proxy.env 的 PROXY_BEARER_TOKEN 用同一密钥签发）
MCP_JWT_SECRET=<足够长的随机串，如 openssl rand -hex 32>

# 只绑回环，交给前面的 mcp-auth-proxy 转发
MCP_ADDR=127.0.0.1:8081

# ── 语音播报 TTS（可选，留空=不启用 send_voice）─────────────────
# Azure：默认 distroless 镜像开箱即用（纯 HTTP + ogg 直出，无需改 Dockerfile）
TTS_PROVIDER=azure
AZURE_TTS_KEY=<azure_speech_key>
AZURE_TTS_REGION=eastasia
# AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural
#
# edge-tts：免费无 key，但默认 distroless 镜像跑不了（需 Python+转码工具）。
# 要用 edge 需改用 deploy/Dockerfile.edge 构建，并改成：
#   TTS_PROVIDER=edge
#   EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
