# mcp-auth-proxy —— Caddy 前置版（HTTP-only，不自己占 443）
# 复制为 proxy.env 填值；勿提交真实值。

EXTERNAL_URL=https://narglc.eu.org   # 对外域名，proxy 据此生成 https URL

# 关掉自带 ACME，由 Caddy 统一签证书
NO_AUTO_TLS=true
LISTEN=:8080                          # 只听内部 HTTP 端口

# 信任前置 Caddy 传来的 X-Forwarded-Proto/Host，否则可能重定向死循环
# 宿主 Caddy 用 127.0.0.1/32；docker Caddy 用私网段 172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
TRUSTED_PROXIES=127.0.0.1/32

# Google OAuth（Console 里回调填 https://<域名>/.auth/google/callback）
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
GOOGLE_ALLOWED_USERS=you@gmail.com

# 转发给后端 bot 时注入的 JWT（bot -mktoken <chat_id> 生成）
PROXY_BEARER_TOKEN=<用 bot -mktoken 生成的 JWT>

DATA_PATH=/data                       # docker 版落到卷；宿主版可改本地路径
