# gohome bot 环境变量（复制为 bot.env 填值；勿提交真实值）
TOKEN=<telegram_bot_token>
MCP_TARGET_CHAT_ID=<你的chat_id>     # 启用 MCP + 免鉴权时默认目标
MCP_JWT_SECRET=<openssl rand -hex 32>  # 与 PROXY_BEARER_TOKEN 同一密钥签发
# RDB_URL / MCP_ADDR 由 compose 固定注入，无需在此填

# 语音播报 TTS（可选，留空=不启用）。Azure 默认镜像开箱即用；edge 需 Dockerfile.edge。
TTS_PROVIDER=azure
AZURE_TTS_KEY=<azure_speech_key>
AZURE_TTS_REGION=eastasia
