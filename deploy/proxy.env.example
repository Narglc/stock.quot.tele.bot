# mcp-auth-proxy 环境变量（复制为 /etc/gohome/proxy.env 并填值；勿提交真实值）
# 代理对 claude.ai 提供标准 OAuth2.1 + DCR，用户登录委托给 Google；
# 校验通过后把 PROXY_BEARER_TOKEN（我们的 JWT）注入 Authorization 转发给 bot。
# 所有项都是 mcp-auth-proxy 支持的环境变量（见 main.go getEnvWithDefault）。

# 你的公网域名（DNS A 记录指向本机；ACME 据此签证书）
EXTERNAL_URL=https://mcp.example.com

# 自动 Let's Encrypt（需放通 80/443）；或改用 TLS_CERT_FILE/TLS_KEY_FILE
TLS_ACCEPT_TOS=true
# LISTEN=:80          # 默认
# TLS_LISTEN=:443     # 默认

# Google OAuth（在 Google Cloud Console 创建 Web 应用凭据）
GOOGLE_CLIENT_ID=<google_oauth_client_id>
GOOGLE_CLIENT_SECRET=<google_oauth_client_secret>
# 只允许你自己登录（逗号分隔多个）
GOOGLE_ALLOWED_USERS=you@gmail.com

# 转发给后端 bot 时注入的 Bearer（用 bot -mktoken 签发，见 README 第 4 步）
PROXY_BEARER_TOKEN=<用 bot -mktoken 生成的 JWT>

# 代理的持久化目录（存 OAuth 动态注册的 client 等状态）
DATA_PATH=/var/lib/gohome/mcp-proxy
