[Unit]
Description=mcp-auth-proxy (OAuth front for gohome MCP)
After=network-online.target gohome-bot.service
Wants=network-online.target

[Service]
Type=simple
User=gohome
# 所有配置走 proxy.env 的环境变量；命令行只留上游（位置参数）
EnvironmentFile=/etc/gohome/proxy.env
# 上游填 bot 根地址（不带 /mcp）：代理把外部路径 /mcp 拼到上游后得 /mcp；写成 .../mcp 会变 /mcp/mcp → 404
ExecStart=/opt/gohome/mcp-auth-proxy -- http://127.0.0.1:8081
# 非 root 绑定 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
